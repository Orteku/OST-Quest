# Copia este fichero a .dev.vars para desarrollo local
# NUNCA subas .dev.vars a git (ya está en .gitignore)

# ── JWT ─────────────────────────────────────────────────────────────────────
# Debe coincidir exactamente con el JWT Secret de Supabase:
# Supabase Dashboard → Settings → API → JWT Settings → JWT Secret
JWT_SECRET=tu-jwt-secret-de-supabase

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
# Service Role Key (Settings → API → service_role) — nunca la uses en el cliente
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Google OAuth ──────────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Discord OAuth ─────────────────────────────────────────────────────────────
# discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Twitch OAuth ──────────────────────────────────────────────────────────────
# dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Steam ─────────────────────────────────────────────────────────────────────
# steamcommunity.com/dev/apikey
STEAM_API_KEY=

# ── Resend (email) ────────────────────────────────────────────────────────────
# resend.com → API Keys
RESEND_API_KEY=re_...
